<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PongGame.PongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pong Game" Height="600" Width="800" Background="Black">
    <Grid>
        <!-- Верхняя панель с счётом -->
        <TextBlock x:Name="ScoreText" 
                   Text="Игрок: 0 | Компьютер: 0" 
                   FontSize="24" 
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,10,0,0"/>

        <!-- Игровое поле -->
        <Canvas x:Name="GameCanvas"
                Width="800" 
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#222">
                
            <!-- Ракетка игрока -->
            <Rectangle x:Name="PlayerPaddle" 
                       Width="30" Height="100" 
                       Fill="White"
                       Canvas.Left="20" Canvas.Top="200"/>
            
            <!-- Ракетка ИИ -->
            <Rectangle x:Name="AiPaddle" 
                       Width="30" Height="100" 
                       Fill="White"
                       Canvas.Left="750" Canvas.Top="200"/>
            
            <!-- Шар -->
            <Ellipse x:Name="Ball" 
                     Width="20" Height="20" 
                     Fill="White"
                     Canvas.Left="390" Canvas.Top="190"/>
        </Canvas>

        <!-- Панель управления -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">
            <Button Content="Старт" Width="120" Height="40" Margin="5"/>
            <Button Content="Сброс" Width="120" Height="40" Margin="5"/>
            <Button Content="Выход" Width="120" Height="40" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>